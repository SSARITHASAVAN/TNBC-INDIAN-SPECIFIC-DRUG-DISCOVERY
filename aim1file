<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>TNBC-India Atlas — Single-file Live Pipeline</title>

  <!-- Fonts -->
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;600&family=Inter:wght@400;600&display=swap" rel="stylesheet">

  <!-- SmilesDrawer (2D renderer) -->
  <script src="https://cdn.jsdelivr.net/npm/smiles-drawer@2.0.1/dist/smiles-drawer.min.js"></script>

  <style>
    :root{
      --bg:#F9FAFB;--s1:#F3F4F6;--b1:#CBD5E1;--t1:#111827;--t2:#374151;--t3:#6B7280;
      --accent:#3B82F6;--mono:'IBM Plex Mono',monospace;--sans:'Inter',system-ui,sans-serif;
    }
    *{box-sizing:border-box}
    html,body{height:100%;margin:0;font-family:var(--sans);background:var(--bg);color:var(--t1)}
    nav{height:56px;background:#0b1220;color:#fff;display:flex;align-items:center;padding:0 16px;gap:12px}
    .brand{font-family:var(--mono);font-weight:700}
    .wrap{max-width:1200px;margin:18px auto;padding:0 16px}
    .panel{background:#fff;border:1px solid var(--b1);border-radius:10px;padding:14px;margin-bottom:18px}
    h1{margin:0 0 8px 0;font-size:18px}
    p.lead{margin:0 0 12px 0;color:var(--t2)}
    .row{display:flex;gap:10px;flex-wrap:wrap}
    .col{flex:1;min-width:220px}
    .btn{background:var(--accent);color:#fff;border:none;padding:8px 10px;border-radius:6px;cursor:pointer}
    .btn.secondary{background:#eef2ff;color:var(--accent);border:1px solid var(--accent)}
    .btn.ghost{background:transparent;border:1px solid var(--b1);color:var(--t2)}
    input[type=file]{display:inline-block}
    textarea{width:100%;min-height:120px;font-family:var(--mono);padding:8px;border:1px solid var(--b1);border-radius:6px}
    table{width:100%;border-collapse:collapse;font-size:13px}
    th,td{padding:8px;border-bottom:1px solid var(--b1);text-align:left;vertical-align:top}
    th{background:#fafafa;font-family:var(--mono);font-size:12px;color:var(--t3)}
    .small{font-size:12px;color:var(--t3)}
    .status{font-family:var(--mono);font-size:12px;color:var(--t3)}
    .controls{display:flex;gap:8px;align-items:center;flex-wrap:wrap}
    .tag{display:inline-block;padding:4px 8px;border-radius:999px;background:#eef2ff;color:var(--accent);font-family:var(--mono);font-size:12px}
    .canvas-smiles{width:120px;height:80px}
    .spinner{display:inline-block;width:14px;height:14px;border-radius:50%;border:2px solid rgba(0,0,0,0.08);border-top-color:var(--accent);animation:spin .9s linear infinite}
    @keyframes spin{to{transform:rotate(360deg)}}
    .panel-grid{display:grid;grid-template-columns:1fr 420px;gap:12px}
    .muted{color:var(--t3);font-size:13px}
    .pathways-list{max-height:220px;overflow:auto;padding:6px;border:1px dashed var(--b1);border-radius:6px;background:#fafafa}
    .export-links{display:flex;gap:8px;flex-wrap:wrap}
    .note{font-size:13px;color:var(--t3);margin-top:8px}
    .danger{color:#b91c1c}
    .kbd{font-family:var(--mono);background:#f3f4f6;padding:2px 6px;border-radius:4px;font-size:12px}
    .footer{font-size:13px;color:var(--t3);margin-top:10px}
    @media(max-width:980px){.panel-grid{grid-template-columns:1fr}}
  </style>
</head>
<body>
  <nav>
    <div class="brand">TNBC-India Atlas — Live Pipeline</div>
    <div style="margin-left:auto" class="small">Single-file HTML — client-first</div>
  </nav>

  <div class="wrap">

    <!-- Header -->
    <div class="panel">
      <h1>Gene-driven Compound Fetch + SMILES Viewer + Pathway Enrichment</h1>
      <p class="lead">Upload a gene list (plain text, CSV, TSV). This single HTML file normalizes symbols (MyGene.info), resolves ChEMBL targets, fetches activities (including SMILES), renders 2D structures inline, runs pathway enrichment (Reactome), and offers a retrosynthesis call placeholder (server proxy recommended).</p>
      <div class="row controls">
        <div class="tag">Client-only first pass</div>
        <div class="tag">ChEMBL & MyGene live fetch</div>
        <div class="tag">SMILES 2D via SmilesDrawer</div>
        <div class="tag">Pathway enrichment (Reactome)</div>
      </div>
      <p class="note">Important: Some APIs may enforce CORS. If you encounter CORS errors, host this file on GitHub Pages or run a small proxy server (recommended for production) that stores API keys and forwards requests.</p>
    </div>

    <!-- Main panels -->
    <div class="panel-grid">

      <!-- Left: Upload, normalize, fetch, table -->
      <div>

        <!-- Upload & controls -->
        <div class="panel">
          <h2 style="font-size:15px;margin-bottom:6px">1) Upload / Paste Genes</h2>
          <div class="row" style="align-items:center;margin-bottom:8px">
            <input id="geneFile" type="file" accept=".txt,.csv,.tsv" />
            <button class="btn" onclick="loadGenesFromFile()">Upload & Parse</button>
            <button class="btn secondary" onclick="pasteSample()">Load Sample</button>
            <button class="btn ghost" onclick="clearAll()">Clear All</button>
          </div>

          <div style="display:flex;gap:8px;margin-bottom:8px">
            <textarea id="geneText" placeholder="Or paste gene symbols here, one per line (e.g., BRCA1)"></textarea>
          </div>

          <div style="display:flex;gap:8px;align-items:center">
            <button class="btn" onclick="normalizeThenFetch()">2) Normalize & Fetch ChEMBL</button>
            <div id="status" class="status">Idle.</div>
          </div>

          <div style="margin-top:10px;display:flex;gap:8px;align-items:center">
            <div class="small">Targets dropdown:</div>
            <select id="targetSelect" style="min-width:220px;padding:6px;border:1px solid var(--b1);border-radius:6px" onchange="filterByTarget()">
              <option value="">All targets</option>
            </select>
            <input id="searchBox" placeholder="Search compounds / IDs" style="flex:1;padding:6px;border:1px solid var(--b1);border-radius:6px" oninput="filterTable()" />
            <button class="btn ghost" onclick="exportCsv()">Export CSV</button>
            <button class="btn ghost" onclick="exportJson()">Export JSON</button>
          </div>

          <div class="note">Progress and unmatched genes appear below. Use the debug panel to inspect normalized symbols.</div>
        </div>

        <!-- Compounds table -->
        <div class="panel" style="margin-top:12px">
          <h2 style="font-size:15px;margin-bottom:6px">3) Compounds & Structures</h2>
          <div class="muted" id="summary">No compounds yet.</div>
          <div style="margin-top:8px;overflow:auto;max-height:520px">
            <table id="compoundsTable">
              <thead>
                <tr>
                  <th>ID</th>
                  <th>Name</th>
                  <th>Target</th>
                  <th>IC50 (nM)</th>
                  <th>MW</th>
                  <th>SMILES</th>
                  <th>Structure</th>
                  <th>Source</th>
                </tr>
              </thead>
              <tbody id="compoundsTbody"></tbody>
            </table>
          </div>
        </div>

      </div>

      <!-- Right: Debug, Pathway, Retrosynthesis -->
      <div>

        <!-- Debug / loaded genes -->
        <div class="panel">
          <h2 style="font-size:15px;margin-bottom:6px">Debug / Gene Preview</h2>
          <div style="display:flex;gap:8px;margin-bottom:8px">
            <button class="btn ghost" onclick="showLoadedGenes()">Show Loaded</button>
            <button class="btn ghost" onclick="showNormalizedGenes()">Show Normalized</button>
            <button class="btn ghost" onclick="showUnmatched()">Show Unmatched</button>
            <button class="btn ghost" onclick="consoleLog()">Console Log</button>
          </div>
          <textarea id="debugArea" readonly placeholder="Parsed / normalized genes will appear here"></textarea>
        </div>

        <!-- Pathway enrichment -->
        <div class="panel" style="margin-top:12px">
          <h2 style="font-size:15px;margin-bottom:6px">Pathway Enrichment (Reactome)</h2>
          <div class="muted">Select normalized genes and run enrichment. Reactome Analysis Service is used (may require proxy for CORS).</div>
          <div style="margin-top:8px;display:flex;gap:8px">
            <button class="btn" onclick="runPathwayEnrichment()">Run Enrichment</button>
            <button class="btn secondary" onclick="exportPathways()">Export Pathways</button>
          </div>
          <div style="margin-top:10px">
            <div class="small">Top pathways</div>
            <div id="pathways" class="pathways-list">No results yet.</div>
          </div>
        </div>

        <!-- Retrosynthesis -->
        <div class="panel" style="margin-top:12px">
          <h2 style="font-size:15px;margin-bottom:6px">Retrosynthesis (server proxy recommended)</h2>
          <div class="muted">Enter a SMILES and call your retrosynthesis proxy (ASKCOS / AiZynth / PostEra). This HTML includes a client-side call to <span class="kbd">/api/retrosynthesis</span> — implement a small Node/Express proxy to forward requests and store API keys.</div>
          <div style="margin-top:8px;display:flex;gap:8px">
            <input id="retroSmiles" placeholder="SMILES (e.g. CC(=O)Oc1ccccc1C(=O)O)" style="flex:1;padding:8px;border:1px solid var(--b1);border-radius:6px" />
            <button class="btn" onclick="callRetrosynthesis()">Run</button>
          </div>
          <div style="margin-top:8px">
            <div id="retroResult" class="muted">No retrosynthesis run yet.</div>
          </div>
        </div>

        <div class="panel" style="margin-top:12px">
          <h2 style="font-size:15px;margin-bottom:6px">Notes & Next Steps</h2>
          <ul class="muted">
            <li>For production, run a small Node/Express proxy that stores API keys and forwards requests to ChEMBL/PubChem/retrosynthesis APIs to avoid CORS and protect keys.</li>
            <li>SMILES rendering uses SmilesDrawer (client-side). For large batches, consider server-side molecule caching.</li>
            <li>Pathway enrichment uses Reactome Analysis Service. If blocked by CORS, proxy the request.</li>
            <li>Exported CSV/JSON include SMILES so you can run retrosynthesis or docking offline.</li>
          </ul>
        </div>

      </div>

    </div>

    <div class="footer">When you are ready to publish: commit this file as <code>index.html</code> to a GitHub repo and enable GitHub Pages. For production, add a small Node/Express proxy (example available on request) and host the proxy on a secure server.</div>

  </div>

  <!-- =========================
       JavaScript: pipeline
       ========================= -->
  <script>
  /* ---------------- CONFIG ---------------- */
  const CFG = {
    chembl_base: 'https://www.ebi.ac.uk/chembl/api/data',
    mygene_query: 'https://mygene.info/v3/query',
    reactome_analysis: 'https://reactome.org/AnalysisService/identifiers', // POST
    batchSize: 20,
    activitiesPerTarget: 300,
    retryDelay: 1000,
    maxRetries: 2,
    smilesDrawerOptions: { width: 120, height: 80, padding: 10 }
  };

  /* ---------------- STATE ---------------- */
  let rawGeneTokens = [];
  let geneList = [];
  let normalizedGenes = [];
  let unmatchedGenes = new Set();
  let compounds = []; // array of rows {ID,Name,Target,IC50,MW,SMILES,Source}
  let isRunning = false;

  /* ---------------- UTIL ---------------- */
  function delay(ms){ return new Promise(r=>setTimeout(r,ms)); }
  function el(id){ return document.getElementById(id); }
  function logStatus(s){ el('status').textContent = s; }
  function setSummary(){ el('summary').textContent = `${compounds.length} compounds collected — ${normalizedGenes.length} normalized genes` }

  async function fetchWithRetries(url, opts={}, retries=CFG.maxRetries){
    for(let attempt=0; attempt<=retries; attempt++){
      try{
        const r = await fetch(url, opts);
        if(!r.ok) throw new Error('HTTP ' + r.status);
        return await r.json();
      } catch(e){
        if(attempt === retries) throw e;
        await delay(CFG.retryDelay * (attempt+1));
      }
    }
  }

  /* ---------------- FILE PARSING ---------------- */
  function loadGenesFromFile(){
    const f = el('geneFile').files[0];
    if(!f){
      alert('Choose a gene file (.txt, .csv, .tsv) or paste into the text area.');
      return;
    }
    const reader = new FileReader();
    reader.onload = e => {
      const text = e.target.result;
      parseGeneText(text);
    };
    reader.readAsText(f);
  }

  function pasteSample(){
    // small sample to test quickly
    const sample = ['BRCA1','TP53','EGFR','PIK3CA','PARP1','STAT3','AKT1','MTOR','CDK4','CDK6'].join('\n');
    el('geneText').value = sample;
    parseGeneText(sample);
  }

  function parseGeneText(text){
    const lines = text.split(/\r?\n/).map(l=>l.trim()).filter(Boolean);
    const tokens = [];
    for(const line of lines){
      const parts = line.split(/[\t,;|]/).map(p=>p.trim()).filter(Boolean);
      for(const p of parts){
        // remove parentheses and weird chars
        const cleaned = p.replace(/[():

\[\]

{}]/g,' ').replace(/[^A-Za-z0-9_\- ]/g,' ').trim();
        const candidates = cleaned.split(/\s+/).filter(Boolean);
        for(const c of candidates){
          if(/[A-Za-z]/.test(c) && c.length>=2 && c.length<=12){
            tokens.push(c.toUpperCase());
          }
        }
      }
    }
    rawGeneTokens = Array.from(new Set(tokens));
    geneList = rawGeneTokens.slice();
    el('debugArea').value = rawGeneTokens.join('\n');
    el('status').textContent = `${geneList.length} gene tokens parsed`;
    populateTargetSelect([]);
    alert('Parsed ' + geneList.length + ' candidate gene tokens. Click Normalize & Fetch to continue.');
  }

  function clearAll(){
    rawGeneTokens = []; geneList = []; normalizedGenes = []; unmatchedGenes = new Set(); compounds = [];
    el('geneText').value = ''; el('debugArea').value = ''; el('compoundsTbody').innerHTML = ''; el('targetSelect').innerHTML = '<option value="">All targets</option>';
    el('status').textContent = 'Cleared';
    setSummary();
  }

  /* ---------------- NORMALIZATION (MyGene.info) ---------------- */
  async function normalizeGenes(tokens){
    const normalized = [];
    const mapTokenToCanonical = {};
    const batchSize = 200;
    for(let i=0;i<tokens.length;i+=batchSize){
      const batch = tokens.slice(i,i+batchSize);
      const q = batch.map(t => `symbol:${t} OR alias:${t} OR name:${t}`).join(' OR ');
      const params = new URLSearchParams();
      params.set('q', q);
      params.set('fields', 'symbol,name,entrezgene,ensembl');
      params.set('size', batch.length * 2);
      const url = `${CFG.mygene_query}?${params.toString()}`;
      try{
        const resp = await fetch(url);
        if(!resp.ok) throw new Error('MyGene error ' + resp.status);
        const data = await resp.json();
        const hits = data.hits || [];
        const hitByQuery = {};
        for(const h of hits){
          const sym = (h.symbol || '').toUpperCase();
          if(sym) hitByQuery[sym] = h;
          if(h.alias && Array.isArray(h.alias)){
            for(const a of h.alias) hitByQuery[String(a).toUpperCase()] = h;
          }
        }
        for(const t of batch){
          const h = hitByQuery[t] || hitByQuery[t.replace(/-/g,'')] || null;
          if(h && h.symbol) mapTokenToCanonical[t] = h.symbol.toUpperCase();
          else mapTokenToCanonical[t] = null;
        }
      } catch(e){
        console.warn('MyGene batch failed', e);
        for(const t of batch) mapTokenToCanonical[t] = null;
      }
      await delay(200);
    }
    for(const t of tokens){
      const canon = mapTokenToCanonical[t];
      if(canon) normalized.push(canon);
      else normalized.push(t);
    }
    const uniq = Array.from(new Set(normalized));
    normalizedGenes = uniq;
    return uniq;
  }

  /* ---------------- MAIN: normalize then fetch ---------------- */
  async function normalizeThenFetch(){
    if(isRunning) return;
    // if user pasted text, parse it
    if(!geneList.length && el('geneText').value.trim()){
      parseGeneText(el('geneText').value);
    }
    if(!geneList.length){ alert('No genes parsed. Upload file or paste gene symbols.'); return; }
    isRunning = true;
    logStatus('Normalizing gene symbols (MyGene.info)...');
    try{
      const norm = await normalizeGenes(geneList);
      el('debugArea').value = norm.join('\n');
      populateTargetSelect(norm);
      unmatchedGenes = new Set();
      compounds = [];
      el('compoundsTbody').innerHTML = '';
      await startFetchForGenes(norm);
    } catch(e){
      console.error('Normalization failed', e);
      alert('Normalization failed. See console for details.');
    } finally {
      isRunning = false;
    }
  }

  /* ---------------- ChEMBL pipeline ---------------- */
  async function startFetchForGenes(genes){
    if(!genes || !genes.length) { alert('No genes to fetch'); return; }
    logStatus('Resolving targets and fetching compounds...');
    compounds = [];
    // iterate in batches to avoid overloading
    for(let i=0;i<genes.length;i+=CFG.batchSize){
      const batch = genes.slice(i,i+CFG.batchSize);
      logStatus(`Resolving targets for genes ${i+1}-${i+batch.length} of ${genes.length}...`);
      const targetsMap = await fetchTargetsForGenes(batch);
      for(const g of batch){
        const tlist = targetsMap[g] || [];
        if(!tlist.length){ unmatchedGenes.add(g); continue; }
        for(const t of tlist){
          logStatus(`Fetching activities for ${t.target_chembl_id} (${g})...`);
          try{
            const acts = await fetchActivitiesForTarget(t.target_chembl_id, CFG.activitiesPerTarget);
            // for each activity, we will fetch molecule details to get SMILES (molecule endpoint)
            for(const a of acts){
              const molId = a.molecule_chembl_id || a.molecule_chembl_id;
              if(!molId) continue;
              // create a row with basic info; SMILES will be filled after molecule fetch
              const row = {
                ID: molId,
                Name: a.molecule_pref_name || a.pref_name || '',
                Target: g,
                IC50: extractIc50(a),
                MW: a.molecule_properties ? a.molecule_properties.full_molweight : '',
                SMILES: '',
                Source: 'ChEMBL'
              };
              compounds.push(row);
            }
            // dedupe and render partial
            compounds = dedupeCompounds(compounds);
            renderCompounds(compounds);
            // fetch SMILES for unique molecule IDs in this batch (parallel but limited)
            const uniqueMolIds = Array.from(new Set(compounds.map(c=>c.ID))).slice(0,2000);
            await fetchSmilesForMolecules(uniqueMolIds);
          } catch(e){
            console.warn('Activities fetch failed for', t.target_chembl_id, e);
          }
          await delay(120);
        }
      }
      await delay(300);
    }
    logStatus(`Done. ${compounds.length} unique compounds collected.`);
    setSummary();
  }

  /* Fetch ChEMBL targets for genes (concurrent workers) */
  async function fetchTargetsForGenes(genes){
    const out = {};
    const concurrency = 6;
    let idx = 0;
    async function worker(){
      while(idx < genes.length){
        const g = genes[idx++];
        try{
          const url = `${CFG.chembl_base}/target/search.json?target_synonym=${encodeURIComponent(g)}&limit=50`;
          const res = await fetchWithRetries(url);
          if(res && res.targets && res.targets.length){
            out[g] = res.targets.map(t=>({ target_chembl_id: t.target_chembl_id, pref_name: t.pref_name }));
          } else {
            const url2 = `${CFG.chembl_base}/target/search.json?pref_name=${encodeURIComponent(g)}&limit=50`;
            const res2 = await fetchWithRetries(url2);
            out[g] = (res2 && res2.targets) ? res2.targets.map(t=>({ target_chembl_id: t.target_chembl_id, pref_name: t.pref_name })) : [];
          }
        } catch(e){
          console.warn('Target lookup error for', g, e);
          out[g] = [];
        }
      }
    }
    const workers = Array.from({length:concurrency},()=>worker());
    await Promise.all(workers);
    return out;
  }

  /* Fetch activities for a target (paginated) */
  async function fetchActivitiesForTarget(targetChemblId, maxRecords=300){
    const pageSize = 100;
    let fetched = [];
    let offset = 0;
    while(fetched.length < maxRecords){
      const limit = Math.min(pageSize, maxRecords - fetched.length);
      const url = `${CFG.chembl_base}/activity.json?target_chembl_id=${encodeURIComponent(targetChemblId)}&limit=${limit}&offset=${offset}`;
      const res = await fetchWithRetries(url);
      if(!res || !res.activities || !res.activities.length) break;
      fetched = fetched.concat(res.activities);
      if(res.activities.length < limit) break;
      offset += limit;
      if(offset > 5000) break;
    }
    return fetched;
  }

  /* Extract IC50 numeric in nM */
  function extractIc50(act){
    if(!act) return '';
    if(act.standard_type && act.standard_value){
      const val = parseFloat(act.standard_value);
      const unit = (act.standard_units || '').toLowerCase();
      if(isNaN(val)) return `${act.standard_value} ${act.standard_units||''}`;
      if(unit === 'nm') return val;
      if(unit === 'um' || unit === 'μm' || unit === 'µm') return val * 1000;
      if(unit === 'm') return val * 1e9;
      if(unit === 'pm') return val / 1000;
      return val;
    }
    return '';
  }

  /* Dedupe compounds by ID */
  function dedupeCompounds(list){
    const map = new Map();
    list.forEach(r=>{
      const id = (r.ID||'').trim();
      if(!id) return;
      if(!map.has(id)) map.set(id, r);
      else {
        const ex = map.get(id);
        for(const k of Object.keys(r)) if(!ex[k] && r[k]) ex[k] = r[k];
      }
    });
    return Array.from(map.values());
  }

  /* Render compounds table */
  function renderCompounds(rows){
    const tbody = el('compoundsTbody');
    tbody.innerHTML = '';
    for(const r of rows){
      const tr = document.createElement('tr');
      tr.innerHTML = `
        <td>${escapeHtml(r.ID||'')}</td>
        <td>${escapeHtml(r.Name||'')}</td>
        <td>${escapeHtml(r.Target||'')}</td>
        <td>${escapeHtml(r.IC50||'')}</td>
        <td>${escapeHtml(r.MW||'')}</td>
        <td>${escapeHtml(r.SMILES||'')}</td>
        <td><div data-mol="${escapeHtml(r.SMILES||'')}" class="mol-canvas"></div></td>
        <td>${escapeHtml(r.Source||'')}</td>
      `;
      tbody.appendChild(tr);
    }
    // render SMILES canvases
    setTimeout(()=>{ renderAllSmilesCanvases(); }, 50);
    setSummary();
  }

  /* Escape HTML */
  function escapeHtml(s){ return String(s||'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }

  /* ---------------- SMILES fetching & rendering ---------------- */

  async function fetchSmilesForMolecules(molIds){
    // molIds: array of ChEMBL molecule IDs like CHEMBL25
    // We'll fetch molecule endpoint: /molecule/{chembl_id}.json
    // Limit concurrency
    const concurrency = 6;
    let idx = 0;
    async function worker(){
      while(idx < molIds.length){
        const mid = molIds[idx++];
        try{
          const url = `${CFG.chembl_base}/molecule/${encodeURIComponent(mid)}.json`;
          const res = await fetchWithRetries(url);
          if(res && res.molecule_structures && res.molecule_structures.canonical_smiles){
            const smiles = res.molecule_structures.canonical_smiles;
            // update compounds array entries with this ID
            for(const c of compounds){
              if(c.ID === mid && (!c.SMILES || c.SMILES.length===0)){
                c.SMILES = smiles;
              }
            }
          } else if(res && res.molecule_structures && res.molecule_structures.smiles){
            const smiles = res.molecule_structures.smiles;
            for(const c of compounds){
              if(c.ID === mid && (!c.SMILES || c.SMILES.length===0)){
                c.SMILES = smiles;
              }
            }
          }
        } catch(e){
          // ignore single molecule failures
        }
      }
    }
    const workers = Array.from({length:concurrency},()=>worker());
    await Promise.all(workers);
    // re-render table with SMILES
    renderCompounds(compounds);
  }

  function renderAllSmilesCanvases(){
    const nodes = document.querySelectorAll('.mol-canvas');
    nodes.forEach(node=>{
      const smiles = node.getAttribute('data-mol') || '';
      node.innerHTML = '';
      if(!smiles) { node.textContent = ''; return; }
      // create canvas
      const canvas = document.createElement('canvas');
      canvas.width = CFG.smilesDrawerOptions.width;
      canvas.height = CFG.smilesDrawerOptions.height;
      canvas.className = 'canvas-smiles';
      node.appendChild(canvas);
      try{
        const drawer = new SmilesDrawer.Drawer({width:CFG.smilesDrawerOptions.width, height:CFG.smilesDrawerOptions.height});
        SmilesDrawer.parse(smiles, function(tree){
          drawer.draw(tree, canvas, 'light', false);
        }, function(err){ /* parse error */ node.textContent = '—'; });
      } catch(e){
        node.textContent = '—';
      }
    });
  }

  /* ---------------- FILTERS & UI helpers ---------------- */
  function populateTargetSelect(list){
    const sel = el('targetSelect');
    sel.innerHTML = '<option value="">All targets</option>';
    const arr = list && list.length ? list : normalizedGenes;
    const uniq = Array.from(new Set(arr || []));
    uniq.sort();
    for(const g of uniq){
      const o = document.createElement('option'); o.value = g; o.textContent = g; sel.appendChild(o);
    }
  }

  function filterByTarget(){
    const t = el('targetSelect').value.trim().toLowerCase();
    const q = el('searchBox').value.trim().toLowerCase();
    const filtered = compounds.filter(r=>{
      const matchesT = !t || (r.Target||'').toLowerCase().includes(t);
      const matchesQ = !q || Object.values(r).join(' ').toLowerCase().includes(q);
      return matchesT && matchesQ;
    });
    renderCompounds(filtered);
  }

  function filterTable(){ filterByTarget(); }

  function showLoadedGenes(){ el('debugArea').value = geneList.join('\n') || 'No loaded genes'; }
  function showNormalizedGenes(){ el('debugArea').value = normalizedGenes.join('\n') || 'No normalized genes'; }
  function showUnmatched(){ el('debugArea').value = Array.from(unmatchedGenes).join(', ') || 'No unmatched genes'; }
  function consoleLog(){ console.log({rawGeneTokens,geneList,normalizedGenes,unmatchedGenes,compounds}); alert('State logged to console'); }

  /* ---------------- EXPORTS ---------------- */
  function toCsv(rows){
    if(!rows || !rows.length) return '';
    const esc = v => '"' + String(v ?? '').replace(/"/g,'""') + '"';
    const header = Object.keys(rows[0]).map(esc).join(',');
    const lines = rows.map(r => Object.values(r).map(esc).join(','));
    return [header, ...lines].join('\n');
  }
  function exportCsv(){
    if(!compounds.length){ alert('No compounds to export'); return; }
    const csv = toCsv(compounds);
    downloadText(csv, 'compounds_export.csv', 'text/csv');
  }
  function exportJson(){
    if(!compounds.length){ alert('No compounds to export'); return; }
    downloadText(JSON.stringify(compounds, null, 2), 'compounds_export.json', 'application/json');
  }
  function downloadText(text, filename, mime){
    const blob = new Blob([text], {type:mime});
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a'); a.href = url; a.download = filename; document.body.appendChild(a); a.click();
    setTimeout(()=>{ URL.revokeObjectURL(url); a.remove(); },500);
  }

  /* ---------------- PATHWAY ENRICHMENT (Reactome) ---------------- */
  async function runPathwayEnrichment(){
    if(!normalizedGenes.length){ alert('No normalized genes. Run normalization first.'); return; }
    el('pathways').textContent = 'Running enrichment...';
    try{
      // Reactome expects newline-separated identifiers in POST body
      const body = normalizedGenes.join('\n');
      // Note: Reactome may block CORS; if so, run via proxy.
      const url = CFG.reactome_analysis + '?species=Homo sapiens';
      const res = await fetch(url, { method:'POST', headers:{ 'Content-Type':'text/plain' }, body });
      if(!res.ok) throw new Error('Reactome HTTP ' + res.status);
      const data = await res.json();
      // data contains pathway hits; show top pathways
      if(!data || !data.pathways || !data.pathways.length){
        el('pathways').textContent = 'No pathways returned or Reactome response format changed.';
        return;
      }
      // sort by p-value or entities found
      const sorted = data.pathways.sort((a,b)=>{
        const pa = a.entitiesFound || 0, pb = b.entitiesFound || 0;
        return (pb - pa);
      }).slice(0,40);
      const html = sorted.map(p=>{
        const name = p.stId ? `${p.stId} — ${p.name}` : p.name;
        return `<div style="margin-bottom:6px"><strong>${escapeHtml(name)}</strong><div class="small">Found: ${p.entitiesFound||0} / ${p.entitiesTotal||0} — p=${p.pValue||'n/a'}</div></div>`;
      }).join('');
      el('pathways').innerHTML = html;
    } catch(e){
      console.error('Pathway enrichment failed', e);
      el('pathways').textContent = 'Pathway enrichment failed (CORS or network). Consider using a proxy.';
    }
  }

  function exportPathways(){
    const txt = el('pathways').innerText || '';
    if(!txt) { alert('No pathway results to export'); return; }
    downloadText(txt, 'pathways.txt', 'text/plain');
  }

  /* ---------------- RETROSYNTHESIS (proxy placeholder) ---------------- */
  async function callRetrosynthesis(){
    const smiles = el('retroSmiles').value.trim();
    if(!smiles){ alert('Enter SMILES'); return; }
    el('retroResult').textContent = 'Calling retrosynthesis proxy...';
    try{
      // This endpoint is a placeholder. For production, implement a Node/Express proxy at /api/retrosynthesis
      // that forwards to your chosen retrosynthesis provider (ASKCOS, AiZynth, PostEra) and returns JSON.
      const proxyUrl = '/api/retrosynthesis'; // implement server-side
      const res = await fetch(proxyUrl, {
        method:'POST',
        headers:{ 'Content-Type':'application/json' },
        body: JSON.stringify({ smiles })
      });
      if(!res.ok) throw new Error('Proxy HTTP ' + res.status);
      const data = await res.json();
      el('retroResult').textContent = JSON.stringify(data, null, 2);
    } catch(e){
      console.error('Retrosynthesis call failed', e);
      el('retroResult').textContent = 'Retrosynthesis call failed. Implement a server proxy at /api/retrosynthesis to forward requests to your retrosynthesis provider.';
    }
  }

  /* ---------------- SMALL HELPERS ---------------- */
  function escapeHtml(s){ return String(s||'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }

  /* ---------------- BOOTSTRAP: UI wiring ---------------- */
  function filterByTarget(){ filterTable(); }
  function filterTable(){ // alias
    const t = el('targetSelect').value.trim().toLowerCase();
    const q = el('searchBox').value.trim().toLowerCase();
    const filtered = compounds.filter(r=>{
      const matchesT = !t || (r.Target||'').toLowerCase().includes(t);
      const matchesQ = !q || Object.values(r).join(' ').toLowerCase().includes(q);
      return matchesT && matchesQ;
    });
    renderCompounds(filtered);
  }

  /* ---------------- INITIAL small helpers for user convenience ---------------- */
  function showLoadedGenes(){ el('debugArea').value = geneList.join('\n') || 'No loaded genes'; }
  function showNormalizedGenes(){ el('debugArea').value = normalizedGenes.join('\n') || 'No normalized genes'; }
  function showUnmatched(){ el('debugArea').value = Array.from(unmatchedGenes).join(', ') || 'No unmatched genes'; }

  /* ---------------- On load: attach simple keyboard shortcuts ---------------- */
  document.addEventListener('keydown', (e)=>{
    if(e.ctrlKey && e.key === 'Enter'){ e.preventDefault(); normalizeThenFetch(); }
  });

  /* ---------------- Expose some functions to console for debugging ---------------- */
  window._tnbc = {
    loadGenesFromFile, parseGeneText, normalizeThenFetch, startFetchForGenes, fetchSmilesForMolecules,
    compounds, normalizedGenes, geneList, rawGeneTokens
  };

  /* ---------------- Utility: small wrapper to allow user to paste and parse quickly ---------------- */
  // If user pastes into the geneText area and presses the "Upload & Parse" button, parseGeneText will be called.
  // Provide a small helper to parse when the file input is empty and user clicks Upload & Parse.
  (function attachParseOnButton(){
    const orig = window.loadGenesFromFile;
    window.loadGenesFromFile = function(){
      const f = el('geneFile').files[0];
      if(!f){
        const text = el('geneText').value.trim();
        if(!text){ alert('No file selected and no pasted genes. Paste genes or choose a file.'); return; }
        parseGeneText(text);
        return;
      }
      orig();
    };
  })();

  </script>
</body>
