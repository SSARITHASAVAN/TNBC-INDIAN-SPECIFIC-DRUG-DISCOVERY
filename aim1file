  <script>
  /*************************************************************************
   * Full single-file pipeline
   * - Upload & parse gene list
   * - Normalize via MyGene.info (public)
   * - Fetch ChEMBL targets & activities (molecule SMILES included when available)
   * - Render compounds table with SMILES and 2D viewer (SmilesDrawer)
   * - Pathway enrichment via Reactome (over-representation by gene)
   * - Retrosynthesis call via server proxy endpoint /api/retrosynth (user to implement)
   *
   * Notes:
   * - For production, implement a small Node/Express proxy to avoid CORS and to store API keys.
   * - This file is intentionally self-contained and uses public endpoints where possible.
   *************************************************************************/

  (function(){
    // CONFIG
    const CFG = {
      chembl_base: 'https://www.ebi.ac.uk/chembl/api/data',
      mygene_query: 'https://mygene.info/v3/query',
      reactome_overrep: 'https://reactome.org/AnalysisService/identifiers/projection/enrichment',
      batchSize: 20,
      activitiesPerTarget: 300,
      retryDelay: 1200,
      maxRetries: 2,
      // If you host a proxy, set proxy_base to your server (e.g., 'https://myproxy.example.com')
      proxy_base: '' // <-- set to your proxy URL in production (no trailing slash)
    };

    // STATE
    let rawGeneTokens = [];
    let geneList = [];
    let normalizedGenes = [];
    let unmatchedGenes = new Set();
    let compounds = []; // array of rows
    let isRunning = false;
    let smilesDrawer = null;

    // DOM
    const el = id => document.getElementById(id);
    const terminal = el('terminal');
    const genePreview = el('genePreview');
    const gCount = el('g-count');
    const gNorm = el('g-norm');
    const progressBar = el('progressBar');
    const progressText = el('progressText');
    const compTableBody = document.querySelector('#compTable tbody');
    const targetFilter = el('targetFilter');
    const searchBox = el('searchBox');
    const pathwayList = el('pathwayList');
    const pathwaySummary = el('pathwaySummary');
    const modal = el('modalViewer');
    const smilesCanvas = el('smilesCanvas');
    const viewerSmiles = el('viewerSmiles');
    const retroRoutes = el('retroRoutes');

    // UTIL
    function log(msg){
      const time = new Date().toLocaleTimeString();
      terminal.innerText = `[${time}] ${msg}\n` + terminal.innerText;
    }
    function delay(ms){ return new Promise(r=>setTimeout(r,ms)); }
    function downloadText(text, filename, mime='text/plain'){ const blob=new Blob([text],{type:mime}); const url=URL.createObjectURL(blob); const a=document.createElement('a'); a.href=url; a.download=filename; document.body.appendChild(a); a.click(); setTimeout(()=>{URL.revokeObjectURL(url);a.remove()},500); }
    function toCsv(rows){
      if(!rows.length) return '';
      const keys = Object.keys(rows[0]);
      const esc = v => '"' + String(v ?? '').replace(/"/g,'""') + '"';
      const header = keys.map(esc).join(',');
      const lines = rows.map(r => keys.map(k => esc(r[k])).join(','));
      return [header, ...lines].join('\n');
    }

    // FILE PARSING
    function parseGeneText(text){
      const lines = text.split(/\r?\n/).map(l=>l.trim()).filter(Boolean);
      const tokens = [];
      for(const line of lines){
        const parts = line.split(/[\t,;|]/).map(p=>p.trim()).filter(Boolean);
        for(const p of parts){
          // remove common annotations
          const cleaned = p.replace(/[:\(\)

\[\]

\{\}]/g,' ').replace(/[^A-Za-z0-9_\- ]/g,' ').trim();
          const candidates = cleaned.split(/\s+/).filter(Boolean);
          for(const c of candidates){
            if(/[A-Za-z]/.test(c) && c.length>=2 && c.length<=12){
              tokens.push(c.toUpperCase());
            }
          }
        }
      }
      return Array.from(new Set(tokens));
    }

    // MyGene normalization (batch)
    async function normalizeGenes(tokens){
      const normalized = [];
      const mapTokenToCanonical = {};
      const batchSize = 200;
      for(let i=0;i<tokens.length;i+=batchSize){
        const batch = tokens.slice(i,i+batchSize);
        const q = batch.map(t => `symbol:${t} OR alias:${t} OR name:${t}`).join(' OR ');
        const params = new URLSearchParams();
        params.set('q', q);
        params.set('fields', 'symbol,name,entrezgene,ensembl');
        params.set('size', batch.length * 2);
        const url = `${CFG.mygene_query}?${params.toString()}`;
        try{
          const resp = await fetchWithRetries(url);
          const data = await resp.json();
          const hits = data.hits || [];
          const hitByQuery = {};
          for(const h of hits){
            const sym = (h.symbol || '').toUpperCase();
            if(sym) hitByQuery[sym] = h;
            if(h.alias && Array.isArray(h.alias)){
              for(const a of h.alias) hitByQuery[String(a).toUpperCase()] = h;
            }
          }
          for(const t of batch){
            const h = hitByQuery[t] || hitByQuery[t.replace(/-/g,'')] || null;
            if(h && h.symbol) mapTokenToCanonical[t] = h.symbol.toUpperCase();
            else mapTokenToCanonical[t] = null;
          }
        } catch(e){
          console.warn('MyGene batch failed', e);
          for(const t of batch) mapTokenToCanonical[t] = null;
        }
        await delay(200);
      }
      for(const t of tokens){
        const canon = mapTokenToCanonical[t];
        if(canon) normalized.push(canon);
        else normalized.push(t);
      }
      const uniq = Array.from(new Set(normalized));
      normalizedGenes = uniq;
      return uniq;
    }

    // Fetch with retries
    async function fetchWithRetries(url, retries=CFG.maxRetries){
      for(let attempt=0; attempt<=retries; attempt++){
        try{
          const resp = await fetch(url);
          if(!resp.ok) throw new Error('HTTP ' + resp.status);
          return await resp.json();
        } catch(e){
          if(attempt === retries) throw e;
          await delay(CFG.retryDelay * (attempt+1));
        }
      }
    }

    // ChEMBL: fetch targets for genes (concurrent workers)
    async function fetchTargetsForGenes(genes){
      const out = {};
      const concurrency = 6;
      let idx = 0;
      async function worker(){
        while(idx < genes.length){
          const g = genes[idx++];
          try{
            const url = `${CFG.chembl_base}/target/search.json?target_synonym=${encodeURIComponent(g)}&limit=50`;
            const res = await fetchWithRetries(url);
            if(res && res.targets && res.targets.length){
              out[g] = res.targets.map(t=>({ target_chembl_id: t.target_chembl_id, pref_name: t.pref_name }));
            } else {
              const url2 = `${CFG.chembl_base}/target/search.json?pref_name=${encodeURIComponent(g)}&limit=50`;
              const res2 = await fetchWithRetries(url2);
              out[g] = (res2 && res2.targets) ? res2.targets.map(t=>({ target_chembl_id: t.target_chembl_id, pref_name: t.pref_name })) : [];
            }
          } catch(e){
            console.warn('Target lookup error for', g, e);
            out[g] = [];
          }
        }
      }
      const workers = Array.from({length:concurrency},()=>worker());
      await Promise.all(workers);
      return out;
    }

    // Fetch activities for a target (paginated)
    async function fetchActivitiesForTarget(targetChemblId, maxRecords=300){
      const pageSize = 100;
      let fetched = [];
      let offset = 0;
      while(fetched.length < maxRecords){
        const limit = Math.min(pageSize, maxRecords - fetched.length);
        const url = `${CFG.chembl_base}/activity.json?target_chembl_id=${encodeURIComponent(targetChemblId)}&limit=${limit}&offset=${offset}`;
        const res = await fetchWithRetries(url);
        if(!res || !res.activities || !res.activities.length) break;
        fetched = fetched.concat(res.activities);
        if(res.activities.length < limit) break;
        offset += limit;
        if(offset > 5000) break;
      }
      return fetched;
    }

    // Fetch molecule details (to get SMILES) from ChEMBL molecule endpoint
    async function fetchMoleculeSmiles(molChemblId){
      try{
        const url = `${CFG.chembl_base}/molecule/${encodeURIComponent(molChemblId)}.json`;
        const res = await fetchWithRetries(url);
        if(res && res.molecule_structures && res.molecule_structures.canonical_smiles) return res.molecule_structures.canonical_smiles;
        if(res && res.molecule_structures && res.molecule_structures.smiles) return res.molecule_structures.smiles;
      } catch(e){
        // ignore
      }
      return '';
    }

    // Extract IC50 (nM) from activity
    function extractIc50(act){
      if(!act) return '';
      if(act.standard_type && act.standard_value){
        const val = parseFloat(act.standard_value);
        const unit = (act.standard_units || '').toLowerCase();
        if(isNaN(val)) return `${act.standard_value} ${act.standard_units||''}`;
        if(unit === 'nm') return val;
        if(unit === 'um' || unit === 'μm' || unit === 'µm') return val * 1000;
        if(unit === 'm') return val * 1e9;
        if(unit === 'pm') return val / 1000;
        return val;
      }
      return '';
    }

    // Dedupe compounds by ChEMBL ID
    function dedupeCompounds(list){
      const map = new Map();
      list.forEach(r=>{
        const id = (r.ID||'').trim();
        if(!id) return;
        if(!map.has(id)) map.set(id, r);
        else {
          const ex = map.get(id);
          for(const k of Object.keys(r)) if(!ex[k] && r[k]) ex[k] = r[k];
        }
      });
      return Array.from(map.values());
    }

    // Render compounds table
    function renderCompounds(rows){
      compTableBody.innerHTML = '';
      rows.forEach(r=>{
        const tr = document.createElement('tr');
        const smiles = r.SMILES || '';
        tr.innerHTML = `
          <td>${escapeHtml(r.ID||'')}</td>
          <td>${escapeHtml(r.Name||'')}</td>
          <td>${escapeHtml(r.Target||'')}</td>
          <td style="max-width:220px;word-break:break-all"><a href="#" class="smiles-link" data-smiles="${escapeHtml(smiles)}">${escapeHtml(smiles||'—')}</a></td>
          <td><div class="viewer" data-smiles="${escapeHtml(smiles)}"></div></td>
          <td>${escapeHtml(r['IC50 (nM)']||'')}</td>
          <td>${escapeHtml(r.MW||'')}</td>
          <td>${escapeHtml(r.Source||'')}</td>
        `;
        compTableBody.appendChild(tr);
      });
      // attach smiles click handlers
      document.querySelectorAll('.smiles-link').forEach(a=>{
        a.addEventListener('click', e=>{
          e.preventDefault();
          const s = a.getAttribute('data-smiles') || '';
          openViewer(s);
        });
      });
      // render small viewers
      document.querySelectorAll('.viewer').forEach(div=>{
        const s = div.getAttribute('data-smiles') || '';
        div.innerHTML = '';
        if(s){
          try{
            const drawer = new SmilesDrawer.Drawer({width:120,height:100,compactDrawing:true});
            SmilesDrawer.parse(s, function(tree){
              drawer.draw(tree, div, 'light', false);
            }, function(err){ div.innerHTML = '<div class="muted" style="font-size:.75rem">no structure</div>'; });
          } catch(e){
            div.innerHTML = '<div class="muted" style="font-size:.75rem">no structure</div>';
          }
        } else {
          div.innerHTML = '<div class="muted" style="font-size:.75rem">—</div>';
        }
      });
      el('progressText').innerText = `${rows.length} compounds`;
      el('g-count').innerText = `${rawGeneTokens.length} tokens`;
      el('g-norm').innerText = `${normalizedGenes.length} normalized`;
      populateTargetFilter();
    }

    // Escape HTML
    function escapeHtml(s){ return String(s||'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }

    // Populate target select
    function populateTargetFilter(){
      const set = new Set(compounds.map(c=>c.Target).filter(Boolean));
      targetFilter.innerHTML = '<option value="">All targets</option>';
      Array.from(set).sort().forEach(t=>{
        const o = document.createElement('option'); o.value = t; o.textContent = t; targetFilter.appendChild(o);
      });
    }

    // Main pipeline: normalize then fetch
    async function normalizeThenFetch(){
      if(isRunning) return;
      if(!geneList.length){ alert('No genes parsed. Upload file first.'); return; }
      isRunning = true;
      log('Normalizing gene symbols (MyGene.info)...');
      el('progressText').innerText = 'Normalizing...';
      try{
        const norm = await normalizeGenes(geneList);
        genePreview.value = norm.slice(0,2000).join('\n');
        el('g-norm').innerText = `${norm.length} normalized`;
        normalizedGenes = norm;
        unmatchedGenes = new Set();
        compounds = [];
        compTableBody.innerHTML = '';
        await startFetchForGenes(norm);
      } catch(e){
        console.error('Normalization failed', e);
        alert('Normalization failed. See console.');
      } finally {
        isRunning = false;
      }
    }

    // Start fetch for genes -> targets -> activities -> molecules
    async function startFetchForGenes(genes){
      if(!genes || !genes.length) { alert('No genes to fetch'); return; }
      log('Resolving targets and fetching compounds...');
      el('progressText').innerText = 'Resolving targets...';
      compounds = [];
      // batch by CFG.batchSize
      for(let i=0;i<genes.length;i+=CFG.batchSize){
        const batch = genes.slice(i,i+CFG.batchSize);
        el('progressText').innerText = `Resolving targets for genes ${i+1}-${i+batch.length} of ${genes.length}...`;
        const targetsMap = await fetchTargetsForGenes(batch);
        for(const g of batch){
          const tlist = targetsMap[g] || [];
          if(!tlist.length){ unmatchedGenes.add(g); continue; }
          for(const t of tlist){
            el('progressText').innerText = `Fetching activities for ${t.target_chembl_id} (${g})...`;
            try{
              const acts = await fetchActivitiesForTarget(t.target_chembl_id, CFG.activitiesPerTarget);
              // For each activity, create a row; fetch SMILES lazily (to reduce calls)
              for(const a of acts){
                const row = {
                  ID: a.molecule_chembl_id || '',
                  Name: a.molecule_pref_name || a.pref_name || '',
                  Target: g,
                  'IC50 (nM)': extractIc50(a),
                  MW: a.molecule_properties ? a.molecule_properties.full_molweight : '',
                  Source: 'ChEMBL',
                  SMILES: (a.molecule_structures && (a.molecule_structures.canonical_smiles || a.molecule_structures.smiles)) ? (a.molecule_structures.canonical_smiles || a.molecule_structures.smiles) : ''
                };
                // If SMILES not present in activity, fetch molecule endpoint (but do this sparingly)
                if(!row.SMILES && row.ID){
                  // fetch but don't block the whole pipeline: schedule and attach when available
                  fetchMoleculeSmiles(row.ID).then(s=>{
                    if(s){
                      // find existing row and set SMILES
                      const found = compounds.find(c=>c.ID === row.ID);
                      if(found) { found.SMILES = s; renderCompounds(compounds); }
                    }
                  }).catch(()=>{});
                }
                compounds.push(row);
              }
              compounds = dedupeCompounds(compounds);
              renderCompounds(compounds);
            } catch(e){
              console.warn('Activities fetch failed for', t.target_chembl_id, e);
            }
            await delay(120);
          }
        }
        // update progress bar
        const pct = Math.min(100, Math.round((i+CFG.batchSize)/genes.length*100));
        progressBar.style.width = pct + '%';
        await delay(300);
      }
      el('progressText').innerText = `Done. ${compounds.length} unique compounds collected.`;
      log(`Done. ${compounds.length} compounds.`);
    }

    // Pathway enrichment (Reactome)
    async function runPathwayEnrichment(){
      if(!normalizedGenes.length){ alert('No normalized genes. Run normalization first.'); return; }
      log('Running Reactome pathway enrichment...');
      pathwayList.innerHTML = 'Running enrichment...';
      try{
        // Reactome expects newline-separated identifiers
        const body = normalizedGenes.join('\n');
        // Reactome AnalysisService accepts POST with identifiers; we'll use the projection/enrichment endpoint
        const resp = await fetchWithRetries(CFG.reactome_overrep, 2, {
          method: 'POST',
          headers: {'Content-Type':'text/plain'},
          body
        });
        // The endpoint returns JSON with pathway enrichment; adapt to response shape
        // If the above fails due to CORS, fallback to client-side simple mapping via Reactome content service (limited)
        // For now, attempt to parse resp
        const results = resp || [];
        // If results is an object with 'pathways', adapt
        let list = [];
        if(Array.isArray(results)) list = results;
        else if(results.pathways) list = results.pathways;
        else list = results;
        if(!list || !list.length){
          pathwayList.innerHTML = 'No enriched pathways returned or CORS blocked. Try server proxy.';
          pathwaySummary.innerText = 'No results.';
          return;
        }
        // Render top 30
        pathwayList.innerHTML = '';
        list.slice(0,50).forEach(p=>{
          // adapt fields: displayName, pValue, entitiesFound
          const name = p.name || p.stId || p.displayName || p['pathwayName'] || JSON.stringify(p).slice(0,60);
          const pval = p.pValue || p.pvalue || p['pValue'] || p['fdr'] || '';
          const genesFound = (p.entitiesFound && p.entitiesFound.length) ? p.entitiesFound.join(', ') : (p['genes']||'');
          const div = document.createElement('div');
          div.style.padding = '.35rem .5rem';
          div.style.borderBottom = '1px solid #f3f3f3';
          div.innerHTML = `<div style="font-weight:600">${escapeHtml(name)}</div><div class="muted">p: ${pval} • genes: ${escapeHtml(String(genesFound).slice(0,200))}</div>`;
          div.addEventListener('click', ()=> {
            // open Reactome pathway page if stId present
            const stId = p.stId || p.stId;
            if(stId) window.open(`https://reactome.org/PathwayBrowser/#/${stId}`, '_blank');
          });
          pathwayList.appendChild(div);
        });
        pathwaySummary.innerText = `Top ${Math.min(50,list.length)} pathways returned.`;
        log('Pathway enrichment complete.');
      } catch(e){
        console.error('Pathway enrichment failed', e);
        pathwayList.innerHTML = 'Pathway enrichment failed (CORS or API error). Consider using a server proxy.';
        pathwaySummary.innerText = 'Failed.';
      }
    }

    // Retrosynthesis: call server proxy endpoint /api/retrosynth (POST {smiles})
    async function requestRetrosynthesis(smiles){
      if(!smiles) { alert('No SMILES provided'); return; }
      retroRoutes.innerHTML = 'Requesting retrosynthesis routes...';
      try{
        // If you have a proxy, set CFG.proxy_base to your server and implement /api/retrosynth
        const url = (CFG.proxy_base ? `${CFG.proxy_base}/api/retrosynth` : '/api/retrosynth');
        const resp = await fetch(url, {
          method:'POST',
          headers:{'Content-Type':'application/json'},
          body: JSON.stringify({smiles})
        });
        if(!resp.ok) throw new Error('HTTP ' + resp.status);
        const data = await resp.json();
        // Render routes (adapt to your retrosynthesis provider's response)
        retroRoutes.innerHTML = '';
        if(!data || !data.routes || !data.routes.length){
          retroRoutes.innerHTML = '<div class="muted">No routes returned. Check proxy or provider.</div>';
          return;
        }
        data.routes.forEach((r, idx)=>{
          const d = document.createElement('div');
          d.style.padding = '.5rem';
          d.style.borderBottom = '1px solid #eee';
          d.innerHTML = `<div style="font-weight:600">Route ${idx+1} — steps: ${r.steps?.length || 'n/a'}</div>
                         <div class="muted">${escapeHtml(JSON.stringify(r.steps || r, null, 2).slice(0,800))}</div>`;
          retroRoutes.appendChild(d);
        });
      } catch(e){
        console.error('Retrosynthesis failed', e);
        retroRoutes.innerHTML = '<div class="muted">Retrosynthesis request failed. Implement server proxy and check logs.</div>';
      }
    }

    // Viewer functions
    function openViewer(smiles){
      if(!smiles){ alert('No SMILES available for this molecule'); return; }
      viewerSmiles.innerText = smiles;
      modal.style.display = 'flex';
      // draw with SmilesDrawer
      try{
        const drawer = new SmilesDrawer.Drawer({width:420,height:320});
        SmilesDrawer.parse(smiles, function(tree){
          drawer.draw(tree, smilesCanvas, 'light', false);
        }, function(err){
          smilesCanvas.innerHTML = '<div class="muted">Unable to draw structure</div>';
        });
      } catch(e){
        smilesCanvas.innerHTML = '<div class="muted">Unable to draw structure</div>';
      }
    }
    function closeViewer(){ modal.style.display = 'none'; smilesCanvas.innerHTML = ''; viewerSmiles.innerText = ''; }

    // UI wiring
    document.getElementById('btnLoad').addEventListener('click', ()=>{
      const f = document.getElementById('geneFile').files[0];
      if(!f){ alert('Choose a gene file (.txt, .csv, .tsv)'); return; }
      const reader = new FileReader();
      reader.onload = e => {
        const text = e.target.result;
        rawGeneTokens = parseGeneText(text);
        geneList = rawGeneTokens.slice();
        genePreview.value = geneList.join('\n');
        gCount.innerText = `${geneList.length} tokens`;
        log(`Parsed ${geneList.length} gene tokens.`);
      };
      reader.readAsText(f);
    });

    document.getElementById('btnNormalize').addEventListener('click', async ()=>{
      await normalizeThenFetch();
    });

    document.getElementById('btnClear').addEventListener('click', ()=>{
      rawGeneTokens = []; geneList = []; normalizedGenes = []; unmatchedGenes = new Set(); compounds = [];
      genePreview.value = ''; compTableBody.innerHTML = ''; pathwayList.innerHTML = 'No results yet.'; pathwaySummary.innerText = '';
      gCount.innerText = '0 tokens'; gNorm.innerText = '0 normalized'; progressBar.style.width = '0%'; progressText.innerText = 'Idle';
      log('Cleared state.');
    });

    document.getElementById('btnExportGenes').addEventListener('click', ()=>{
      if(!normalizedGenes.length && !geneList.length) return alert('No genes to export');
      const rows = (normalizedGenes.length ? normalizedGenes : geneList).map(g=>({Gene:g}));
      downloadText(toCsv(rows), 'genes_export.csv', 'text/csv');
    });

    document.getElementById('btnShowUnmatched').addEventListener('click', ()=>{
      if(!unmatchedGenes.size) return alert('No unmatched genes (or none attempted yet).');
      alert('Unmatched genes:\n' + Array.from(unmatchedGenes).join(', '));
    });

    // Exports
    document.getElementById('btnExportCsv').addEventListener('click', ()=>{
      if(!compounds.length) return alert('No compounds to export');
      downloadText(toCsv(compounds), 'compounds_export.csv', 'text/csv');
    });
    document.getElementById('btnExportJson').addEventListener('click', ()=>{
      if(!compounds.length) return alert('No compounds to export');
      downloadText(JSON.stringify(compounds, null, 2), 'compounds_export.json', 'application/json');
    });

    // Search / filter
    searchBox.addEventListener('input', filterTable);
    targetFilter.addEventListener('change', filterTable);
    function filterTable(){
      const q = (searchBox.value||'').toLowerCase();
      const t = (targetFilter.value||'').toLowerCase();
      const filtered = compounds.filter(r=>{
        const matchesQ = !q || Object.values(r).join(' ').toLowerCase().includes(q);
        const matchesT = !t || (r.Target||'').toLowerCase().includes(t);
        return matchesQ && matchesT;
      });
      renderCompounds(filtered);
    }

    // Pathway enrichment
    document.getElementById('btnRunPathway').addEventListener('click', runPathwayEnrichment);
    document.getElementById('btnExportPathway').addEventListener('click', ()=>{
      // simple export of pathwayList innerText
      downloadText(pathwayList.innerText || 'No pathways', 'pathway_report.txt', 'text/plain');
    });

    // Retrosynthesis
    document.getElementById('btnRetro').addEventListener('click', ()=>{
      const s = el('retroSmiles').value.trim();
      requestRetrosynthesis(s);
    });

    // Viewer modal
    el('closeViewer').addEventListener('click', closeViewer);
    el('btnCopySmiles').addEventListener('click', ()=>{
      const s = viewerSmiles.innerText;
      navigator.clipboard.writeText(s).then(()=>alert('SMILES copied'));
    });
    el('btnRetroFromViewer').addEventListener('click', ()=>{
      const s = viewerSmiles.innerText;
      requestRetrosynthesis(s);
      closeViewer();
      goTo('retro');
      el('retroSmiles').value = s;
    });
    el('btnDownloadPng').addEventListener('click', ()=>{
      // export canvas as PNG (SmilesDrawer draws into SVG/Canvas depending on implementation)
      // We'll attempt to convert the smilesCanvas innerHTML SVG to PNG if possible
      const svg = smilesCanvas.querySelector('svg');
      if(!svg) return alert('No SVG available to download');
      const svgData = new XMLSerializer().serializeToString(svg);
      const canvas = document.createElement('canvas');
      canvas.width = svg.viewBox.baseVal.width || 420;
      canvas.height = svg.viewBox.baseVal.height || 320;
      const ctx = canvas.getContext('2d');
      const img = new Image();
      const svgBlob = new Blob([svgData], {type:'image/svg+xml;charset=utf-8'});
      const url = URL.createObjectURL(svgBlob);
      img.onload = function(){
        ctx.drawImage(img,0,0);
        URL.revokeObjectURL(url);
        const png = canvas.toDataURL('image/png');
        const a = document.createElement('a'); a.href = png; a.download = 'molecule.png'; a.click();
      };
      img.src = url;
    });

    // Helper: populate target filter from compounds
    function populateTargetFilter(){
      const set = new Set(compounds.map(c=>c.Target).filter(Boolean));
      targetFilter.innerHTML = '<option value="">All targets</option>';
      Array.from(set).sort().forEach(t=>{
        const o = document.createElement('option'); o.value = t; o.textContent = t; targetFilter.appendChild(o);
      });
    }

    // Simple navigation (panels)
    function goTo(panelId){
      document.querySelectorAll('.panel').forEach(p=>p.style.display='none');
      const p = document.getElementById('panel-'+panelId) || document.getElementById('panel-'+panelId) || document.getElementById('panel-'+panelId);
      // fallback: show all panels by default; user can scroll
      // For this single-file, we keep all panels visible; navigation not required
    }

    // Initialize
    function init(){
      log('App ready. Load a gene file to begin.');
      // attach small viewers for existing table (none yet)
    }
    init();

    // Expose some functions for debugging in console
    window._tnbc = {
      parseGeneText, normalizeGenes, startFetchForGenes, compounds, normalizedGenes, rawGeneTokens
    };

  })();
  </script>
